    "ab_arcade": {
      "type": "ab-arcade",
      "settings": {
        "eyebrow": "Why these 94",
        "heading": "What makes a church a basilica"
      },
      "blocks": {
        "bay_1": {
          "type": "bay",
          "settings": {
            "mark": "I",
            "title": "A papal honor",
            "text": "<p>A minor basilica is a church the Pope has honored for its history, beauty, and life of worship.</p>"
          }
        },
        "bay_2": {
          "type": "bay",
          "settings": {
            "mark": "II",
            "title": "Signs of the title",
            "text": "<p>Its insignia include the ombrellino, a red-and-gold canopy, and the crossed keys of St. Peter. The ombrellino marks every basilica on our map.</p>"
          }
        },
        "bay_3": {
          "type": "bay",
          "settings": {
            "mark": "III",
            "title": "A pilgrim’s indulgence",
            "text": "<p>On certain days, the faithful who devoutly visit a basilica may obtain a plenary indulgence under the usual conditions.</p>"
          }
        }
      },
      "block_order": [
        "bay_1",
        "bay_2",
        "bay_3"
      ]
    },
