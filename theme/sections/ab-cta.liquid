<span class="ab-rule" aria-hidden="true"></span>
<section class="ab-cta">
  <div class="ab-wrap ab-cta__inner">
    {% render 'ab-ombrellino' %}
    <div>
      <h2>{{ section.settings.heading | escape }}</h2>
      <p>{{ section.settings.text | escape }}</p>
    </div>
    {%- if section.settings.button_label != blank -%}
      <a class="ab-btn ab-btn--light" href="{{ section.settings.button_link | default: 'https://americanbasilicas.org' }}">{{ section.settings.button_label | escape }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Pilgrimage band",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Plan your pilgrimage" },
    { "type": "text", "id": "text", "label": "Text", "default": "Photos and history of every basilica, free at americanbasilicas.org." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Open the interactive map" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Pilgrimage band" }]
}
{% endschema %}
